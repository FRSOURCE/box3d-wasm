{
  "name": "@frsource/box3d-wasm",
  "version": "0.2.0",
  "description": "Box3D, Erin Catto's 3D physics engine, compiled to WebAssembly with SIMD and optional wasm threads. Isomorphic: works in browsers and Node.js, auto-detecting thread support.",
  "type": "module",
  "main": "dist/entry.mjs",
  "exports": {
    ".": "./dist/entry.mjs",
    "./standard": "./dist/box3d.mjs",
    "./deluxe": "./dist/box3d.deluxe.mjs",
    "./package.json": "./package.json",
    "./iso": "./dist/iso.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE.box3d.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch-deps": "bash scripts/fetch-deps.sh",
    "build": "bash scripts/build.sh",
    "build:debug": "TARGET_TYPE=Debug bash scripts/build.sh",
    "test": "node --test \"test/*.test.mjs\"",
    "prepublishOnly": "pnpm test",
    "lint": "eslint . && prettier . --check && pnpm lint:native",
    "lint:native": "clang-format --dry-run --Werror csrc/*.cpp",
    "fix": "eslint . --fix && prettier . --write && clang-format -i csrc/*.cpp",
    "release": "semantic-release",
    "release:ci": "pnpm release --yes",
    "release:test": "pnpm release --no-git-tag-version --no-push --skip-npm"
  },
  "keywords": [
    "physics",
    "3d",
    "box3d",
    "box2d",
    "wasm",
    "webassembly",
    "simd",
    "threads",
    "rigid-body",
    "game",
    "simulation"
  ],
  "author": "Luis Montes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FRSOURCE/box3d-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/FRSOURCE/box3d-wasm/issues"
  },
  "homepage": "https://github.com/FRSOURCE/box3d-wasm#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@frsource/eslint-config": "1.86.0",
    "@frsource/prettier-config": "1.48.0",
    "@frsource/semantic-release-config": "1.117.1",
    "clang-format": "1.8.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.5.1",
  "contributors": [
    "Jakub Freisler <jakub.freisler@frsource.org> (https://www.frsource.org/)"
  ]
}
