{
  "name": "@frsource/box3d-wasm",
  "version": "0.2.0",
  "description": "Box3D, Erin Catto's 3D physics engine, compiled to WebAssembly with SIMD and optional wasm threads, behind a flat C ABI and a typed TypeScript frontend. Works in browsers and Node.js.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./standard": {
      "types": "./dist/standard.d.ts",
      "default": "./dist/standard.js"
    },
    "./deluxe": {
      "types": "./dist/deluxe.d.ts",
      "default": "./dist/deluxe.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE.box3d.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:debug": "TARGET_TYPE=Debug bash scripts/build.sh",
    "dev": "pnpm --filter @frsource/box3d-wasm-demo dev",
    "typecheck": "tsc --noEmit && pnpm --filter @frsource/box3d-wasm-demo typecheck",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:types": "vitest run --typecheck.only",
    "bench": "node bench/step.ts",
    "prepublishOnly": "pnpm test",
    "prepack": "pnpm build",
    "lint": "eslint . && prettier . --check && pnpm lint:native",
    "lint:native": "clang-format --dry-run --Werror csrc/*.c csrc/*.h",
    "fix": "eslint . --fix && prettier . --write && clang-format -i csrc/*.c csrc/*.h",
    "release": "semantic-release",
    "release:ci": "pnpm release --yes",
    "release:test": "pnpm release --no-git-tag-version --no-push --skip-npm"
  },
  "keywords": [
    "physics",
    "3d",
    "box3d",
    "box2d",
    "wasm",
    "webassembly",
    "simd",
    "threads",
    "rigid-body",
    "game",
    "simulation",
    "typescript"
  ],
  "author": "Luis Montes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FRSOURCE/box3d-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/FRSOURCE/box3d-wasm/issues"
  },
  "homepage": "https://github.com/FRSOURCE/box3d-wasm#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@erincatto/box3d": "github:erincatto/box3d#e77352cd606dc1a34209094076199549a52ea0a1",
    "@frsource/eslint-config": "1.86.0",
    "@frsource/prettier-config": "1.48.0",
    "@frsource/semantic-release-config": "1.117.1",
    "@types/node": "26.6.4",
    "clang-format": "1.8.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.5.1",
  "contributors": [
    "Jakub Freisler <jakub.freisler@frsource.org> (https://www.frsource.org/)"
  ],
  "types": "dist/index.d.ts",
  "sideEffects": false
}
